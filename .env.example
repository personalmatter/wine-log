# Google Gemini API 키 (Google AI Studio에서 무료 발급: https://aistudio.google.com)
GEMINI_API_KEY=

# 구글 시트 연동 설정 (선택 사항: 서비스 계정 json 파일 경로)
# 예: /Users/gs/.../credentials.json
GOOGLE_SERVICE_ACCOUNT_FILE=

# 저장할 구글 시트 이름 (기본값: 와인 기록장)
GOOGLE_SHEET_NAME=와인 기록장

# 사진을 저장할 구글 드라이브 폴더 ID (선택 사항)
GOOGLE_DRIVE_FOLDER_ID=
